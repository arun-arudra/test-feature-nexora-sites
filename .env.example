# =============================================================================
# Nexora Sites — environment variables
# Copy to `.env.local` for local dev. Set the same keys on your Node host (Vercel,
# Railway, etc.). Never commit real secrets. Bluehost shared FTP cannot run
# Next.js /admin or /api — use a Node host for those.
# =============================================================================

# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
# Canonical site URL (sitemap, metadata, absolute links in emails when needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How many published testimonials to show in the Reviews deck
# (admin can override when Supabase site_settings is connected)
NEXT_PUBLIC_TESTIMONIALS_VISIBLE_COUNT=8

# Homepage Work strip — columns visible at once: 2 | 3 | 4
NEXT_PUBLIC_WORK_COLUMNS=2
# Max projects to show in the homepage Work strip
NEXT_PUBLIC_WORK_MAX_PROJECTS=8

# Cards per page on /news
NEXT_PUBLIC_NEWS_PER_PAGE=9

# -----------------------------------------------------------------------------
# Supabase — admin login (MFA), testimonials, site_settings
# Project Settings → API. Put real values in .env.local / host env only.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be NEXT_PUBLIC_ (bypasses RLS).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -----------------------------------------------------------------------------
# Contentful — News (Delivery API = read-only for public /news)
# Plan B: n8n writes → Delivery API reads. Never put Management token in client.
# -----------------------------------------------------------------------------
CONTENTFUL_NEWS_SPACE_ID=
CONTENTFUL_NEWS_DELIVERY_TOKEN=
CONTENTFUL_NEWS_ENVIRONMENT=master

# Projects — optional separate space; if unset, uses News space + content_type `project`
# CONTENTFUL_PROJECTS_SPACE_ID=
# CONTENTFUL_PROJECTS_DELIVERY_TOKEN=
# CONTENTFUL_PROJECTS_ENVIRONMENT=master

# Optional later (multi-space)
# CONTENTFUL_TESTIMONIALS_SPACE_ID=
# CONTENTFUL_TESTIMONIALS_DELIVERY_TOKEN=

# -----------------------------------------------------------------------------
# CMS admin (/admin) — Node host only (not Bluehost shared FTP)
# Public URL path (default /admin). Other values rewrite → /admin via next.config.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CMS_ADMIN_BASE=/admin
# Management token — server only, used by /api/cms/* proxies (never NEXT_PUBLIC_)
CONTENTFUL_NEWS_MANAGEMENT_TOKEN=
# n8n webhook URL (e.g. Render). Server-only preferred; NEXT_PUBLIC_ is a fallback.
N8N_WEBHOOK_URL=
# NEXT_PUBLIC_N8N_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Contact form email (Resend) — Node host only
# https://resend.com → create API key + verify sending domain
# Without these, enquiries are still logged server-side but emails are skipped.
# -----------------------------------------------------------------------------
# Resend API key (server only)
RESEND_API_KEY=
# Inbox that receives new enquiry notifications (with click-to-call phone + Reply-To)
CONTACT_TO_EMAIL=hello@nexorasites.com
# Alias for CONTACT_TO_EMAIL (either works)
# CONTACT_ADMIN_EMAIL=hello@nexorasites.com
# From address — must be on a verified Resend domain
CONTACT_FROM_EMAIL="Nexora Sites <hello@nexorasites.com>"
# Logo in HTML emails: svg = inline SVG in src/lib/email/logo.ts | image = URL below
EMAIL_LOGO_MODE=svg
# When EMAIL_LOGO_MODE=image — absolute logo URL (blank → SITE_URL/brand/logo-white.svg)
# EMAIL_LOGO_IMAGE_URL=https://nexorasites.com/brand/logo-white.svg

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# GA4 Measurement ID from Admin → Data streams (e.g. G-XXXXXXXXXX). Blank = off.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Optional future
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
